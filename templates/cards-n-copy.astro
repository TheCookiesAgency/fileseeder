---
import type { SectionCardsNCopy } from "@repo/types";
import { getHtmlSimpleCopy } from "@/common/utils/get-html-render.ts";
import { HeadingLevel } from "@repo/constants";

type Props = SectionCardsNCopy;

const { copy: _copy, headingLevel = HeadingLevel.P, list = [] } = Astro.props;
const copy = getHtmlSimpleCopy(_copy, headingLevel);
---

<section class={`o-${className}`}>
  <div class={`c-${className}`}>
    {_copy && <div class={`${className}__copy`} set:html={copy} />}
    {list.length > 0 && (
      <div class={`${className}__list`}>
        {list.map((item) => <article class={`${className}__item`}>{item.name}</article>)}
      </div>
    )}
  </div>
</section>
